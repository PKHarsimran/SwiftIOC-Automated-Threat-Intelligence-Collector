# Bulky, regenerated IOC exports — published via GitHub Pages + workflow
# artifacts instead of being committed (keeps the repo small). The compact
# latest.csv and latest.jsonl remain tracked as the canonical git-hosted feeds.
public/iocs/latest.json
public/iocs/latest.tsv
public/iocs/stix2.json

# Raw feed captures (only created with --save-raw-dir)
public/diagnostics/raw/

# Time-machine SQLite index (large; rebuilt from git history on demand).
# The compact history_summary.json it also produces IS committed.
public/history/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Local sources config (users copy sources.example.yml -> sources.yml)
sources.yml

# Editors / OS
.idea/
.vscode/
.DS_Store
